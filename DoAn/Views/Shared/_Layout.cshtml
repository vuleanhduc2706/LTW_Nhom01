<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - CAKEY</title>
    <link href="~/img/favicon.ico" rel="icon">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;500&family=Lora:wght@600;700&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.10.0/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">
    <link href="~/lib/animate/animate.min.css" rel="stylesheet">
    <link href="~/lib/owlcarousel/assets/owl.carousel.min.css" rel="stylesheet">
    <link href="~/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/style.css" rel="stylesheet" />
</head>
<body>
    <div id="spinner" class="show bg-white position-fixed translate-middle w-100 vh-100 top-50 start-50 d-flex align-items-center justify-content-center">
        <div class="spinner-border text-primary" role="status"></div>
    </div>

    <header class="container-fluid fixed-top px-0 wow fadeIn" data-wow-delay="0.1s">
        <div class="top-bar row gx-0 align-items-center d-none d-lg-flex bg-light py-2 border-bottom">
            <div class="col-lg-12 px-5 text-start">
                <small><i class="fa fa-map-marker-alt me-2 text-primary"></i>140 Lê Trọng Tấn, Tân Phú, TP. HCM</small>
                <small class="ms-4"><i class="fa fa-envelope me-2 text-primary"></i>huit@huit.edu.vn</small>
            </div>
        </div>

        <nav class="navbar navbar-expand-lg navbar-light bg-white py-lg-0 px-lg-5 shadow-sm">
            <a href="@Url.Action("Index","Home")" class="navbar-brand ms-4 ms-lg-0">
                <h3 class="fw-bold m-0">
                    <span style="color:#FF6B6B;">C</span><span style="color:#FFD93D;">A</span><span style="color:#6BCB77;">K</span><span style="color:#4D96FF;">E</span><span style="color:#FF9F1C;">Y</span>
                </h3>
            </a>
            @if (Session["TaiKhoan"] != null)
            {
                var user = (DoAn.Models.NguoiDung)Session["TaiKhoan"];
                if (user.QuyenHan.Trim() == "Admin")
                {
                    <div class="nav-item dropdown ms-3">
                        <a href="#" class="nav-link dropdown-toggle btn btn-sm btn-outline-danger px-3 shadow-sm" data-bs-toggle="dropdown" style="border-radius: 20px;">
                            <i class="fa fa-user-shield me-1"></i> Quản trị hệ thống
                        </a>
                        <div class="dropdown-menu m-0 shadow-sm border-0">
                            <a href="@Url.Action("QuanLyNguoiDung", "Admin")" class="dropdown-item">
                                <i class="fa fa-users me-2 text-primary"></i>Quản lý người dùng
                            </a>
                            <a href="@Url.Action("DuyetNguoiBan", "Admin")" class="dropdown-item">
                                <i class="fa fa-user-check me-2 text-success"></i>Duyệt người bán mới
                            </a>
                            <a href="@Url.Action("QuanLyDonHang", "Admin")" class="dropdown-item">
                                <i class="fa fa-shopping-cart me-2 text-danger"></i>Quản lý Đơn hàng
                            </a>
                            <a href="@Url.Action("QuanLySanPham", "Admin")" class="dropdown-item">
                                <i class="fa fa-box-open me-2 text-warning"></i>Quản lý Sản phẩm
                            </a>
                        </div>
                    </div>
                }
            }
            @* --- DROPDOWN CHO NGƯỜI BÁN --- *@
            @if (Session["TaiKhoan"] != null)
            {
                var user = (DoAn.Models.NguoiDung)Session["TaiKhoan"];
                if (user.QuyenHan != null && user.QuyenHan.Trim().Equals("NguoiBan", StringComparison.OrdinalIgnoreCase))
                {
                    <div class="nav-item dropdown ms-3">
                        <a href="#" class="btn btn-sm btn-outline-success rounded-pill px-3 dropdown-toggle shadow-sm" data-bs-toggle="dropdown">
                            <i class="fa fa-store me-1"></i> Quản lý Shop
                        </a>
                        <div class="dropdown-menu m-0 shadow-sm border-0">
                            <a href="@Url.Action("KhoHang", "QuanLy", new { maND = user.MaND })" class="dropdown-item">
                                <i class="fa fa-boxes me-2 text-primary"></i>Kho hàng của tôi
                            </a>
                            <a href="@Url.Action("QuanLyDonHang", "QuanLy", new { maND = user.MaND })" class="dropdown-item">
                                <i class="fa fa-file-invoice-dollar me-2 text-warning"></i>Đơn hàng khách đặt
                            </a>
                            <a href="@Url.Action("DoanhThu", "QuanLy", new { maND = user.MaND })" class="dropdown-item">
                                <i class="fa fa-chart-line me-2 text-success"></i>Báo cáo doanh thu
                            </a>
                            <a href="@Url.Action("SanPhamBiGo", "QuanLy")" class="dropdown-item">
                                <i class="fa fa-exclamation-circle me-2 text-danger"></i>Sản phẩm bị gỡ
                            </a>
                        </div>
                    </div>
                }
            }

            <button type="button" class="navbar-toggler me-4" data-bs-toggle="collapse" data-bs-target="#navbarCollapse">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarCollapse">
                <div class="navbar-nav ms-auto p-4 p-lg-0">

                    <div class="nav-item dropdown">
                        <a href="#" class="nav-link dropdown-toggle active" data-bs-toggle="dropdown">Các trang chính</a>

                        <div class="dropdown-menu m-0 shadow-sm border-0">
                            <a href="@Url.Action("Index", "Home")" class="dropdown-item">
                                <i class="fa fa-home me-2"></i>Trang chủ
                            </a>
                            <a href="@Url.Action("SanPham", "Home")" class="dropdown-item">
                                <i class="fa fa-birthday-cake me-2"></i>Danh sách sản phẩm
                            </a>
                        </div>
                    </div>

                </div>

            </div>
            <div class="d-none d-lg-flex ms-2 align-items-center">
                @using (Html.BeginForm("SanPham", "Home", FormMethod.Get))
                {
                    <div class="d-flex ms-3">
                        <input class="form-control" type="search" placeholder="Tìm kiếm bánh..." name="kw" style="width:160px;" value="@Request.QueryString["kw"]">
                        <button class="btn btn-primary ms-2" type="submit"><i class="bi bi-search"></i></button>
                    </div>
                }

            <div class="nav-item dropdown ms-3">
                <a class="btn-sm-square bg-white rounded-circle dropdown-toggle shadow-sm" href="#" data-bs-toggle="dropdown">
                    <small class="fa fa-user text-body"></small>
                </a>
                <div class="dropdown-menu dropdown-menu-start m-0 shadow-sm border-0">
                    @if (Session["User"] == null)
                    {
                        <a href="@Url.Action("DangKy", "Home")" class="dropdown-item">Đăng ký</a>
                        <a href="@Url.Action("DangNhap", "Home")" class="dropdown-item">Đăng nhập</a>
                    }
                    else
                    {
                        <div class="dropdown-item text-dark fw-bold py-2">
                            Chào, @Session["User"]
                        </div>

                        <a href="@Url.Action("ThongTinCaNhan", "Home")" class="dropdown-item">
                            <i class="fa fa-id-card me-2 text-primary"></i>Thông tin của tôi
                        </a>
                        <hr class="dropdown-divider">
                        <a href="@Url.Action("DangXuat", "Home")" class="dropdown-item text-danger py-2">
                            <i class="fa fa-power-off me-2"></i>Đăng xuất
                        </a>
                    }
                </div>
            </div>

                <a class="btn-sm-square bg-white rounded-circle ms-3 shadow-sm" href="@Url.Action("GioHang", "GioHang")">
                    <small class="fa fa-shopping-bag text-body"></small>
                </a>
            </div>
        </nav>
    </header>

    <div style="min-height: 600px; margin-top: @(ViewBag.Title == "Chi tiết sản phẩm" ? "160px" : "100px");">
        @RenderBody()
    </div>

    <script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/wow/wow.min.js"></script>
    <script src="~/js/main.js"></script>
    <script src="~/Scripts/jquery-3.4.1.min.js"></script>
    <script src="~/Scripts/bootstrap.bundle.min.js"></script>

    @* THÊM DÒNG NÀY ĐỂ HẾT LỖI *@
    @RenderSection("scripts", required: false)
</body>
</html>