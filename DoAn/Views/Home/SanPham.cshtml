@model DoAn.Models.DuLieu
@{
    ViewBag.Title = "Danh sách sản phẩm";
    ViewBag.BreadcrumbTitle = "Danh sách sản phẩm";
}

<div class="container-xxl py-5">
    <div class="container">
        <div class="row g-0 gx-5 align-items-end">
            <div class="col-lg-4">
                <div class="section-header text-start mb-5 wow fadeInUp" data-wow-delay="0.1s" style="max-width: 500px;">
                    <h1 class="display-5 mb-3">Sản Phẩm Của Chúng Tôi</h1>
                    <p>Những loại bánh ngọt thơm ngon, chất lượng nhất dành cho bạn.</p>
                </div>
            </div>
            <div class="col-lg-8 text-start text-lg-end wow slideInRight" data-wow-delay="0.1s">
                <form action="@Url.Action("SanPham", "Home")" method="get" class="mb-4 d-inline-block w-100">
                    <div class="row g-2 justify-content-end">
                        <div class="col-md-4">
                            <input type="text" name="kw" class="form-control" placeholder="Tên sản phẩm..." value="@Request.QueryString["kw"]" />
                        </div>
                        <div class="col-md-3">
                            <select name="khoanggia" class="form-control">
                                <option value="">-- Mức giá --</option>
                                <option value="0-30000" @(Request.QueryString["khoanggia"] == "0-30000" ? "selected" : "")>Dưới 30.000đ</option>
                                <option value="30000-100000" @(Request.QueryString["khoanggia"] == "30000-100000" ? "selected" : "")>30.000đ - 100.000đ</option>
                                <option value="100000-500000" @(Request.QueryString["khoanggia"] == "100000-500000" ? "selected" : "")>Trên 100.000đ</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-primary w-100"><i class="fa fa-search"></i></button>
                        </div>
                    </div>
                </form>
                @Html.Action("DanhMuc", "Home")
            </div>
        </div>
        <div class="tab-content">
            <div id="tab-1" class="tab-pane fade show p-0 active">
                <div class="row g-4">
                    @foreach (var item in Model.DanhSachSanPham)
                    {
                        <div class="col-xl-3 col-lg-4 col-md-6 wow fadeInUp" data-wow-delay="0.1s">
                            <div class="product-item">
                                <div class="position-relative bg-light overflow-hidden">
                                    <img class="img-fluid w-100" src="@Url.Content("~/img/" + item.HinhAnh)" style="height: 250px; object-fit: cover; @(item.SoLuongTon <= 0 ? "filter: grayscale(100%);" : "")" alt="@item.Ten">

                                    @if (item.SoLuongTon > 0)
                                    {
                                        <div class="bg-secondary rounded text-white position-absolute start-0 top-0 m-4 py-1 px-3">Mới</div>
                                    }
                                    else
                                    {
                                        <div class="bg-danger rounded text-white position-absolute start-0 top-0 m-4 py-1 px-3">Hết hàng</div>
                                    }
                                </div>

                                <div class="text-center p-4">
                                    <a class="d-block h5 mb-2" href="@Url.Action("ChiTiet", "Home", new {id = item.MaSanPham})">@item.Ten</a>
                                    <span class="text-primary me-1">@String.Format("{0:N0}", item.GiaBan) VNĐ</span>
                                    @{
                                        var giagoc = item.GiaBan + 15000;
                                    }
                                    <span class="text-body text-decoration-line-through">@String.Format("{0:N0}", giagoc) VNĐ</span>
                                </div>

                                <div class="d-flex border-top">
                                    <small class="w-50 text-center border-end py-2">
                                        <a class="text-body" href="@Url.Action("ChiTiet", "Home", new {id = item.MaSanPham})">
                                            <i class="fa fa-eye text-primary me-2"></i>Xem chi tiết
                                        </a>
                                    </small>

                                    <small class="w-50 text-center py-2">
                                        @if (item.SoLuongTon > 0)
                                        {
                                            @* KIỂM TRA PHÂN QUYỀN KHI CÒN HÀNG *@
                                            if (Session["TaiKhoan"] != null)
                                            {
                                                var user = (DoAn.Models.NguoiDung)Session["TaiKhoan"];
                                                if (user.QuyenHan.Trim() == "NguoiMua")
                                                {
                                                    <a class="text-body" href="@Url.Action("ThemGioHang", "GioHang", new { ms = item.MaSanPham, strURL = Request.Url.ToString() })">
                                                        <i class="fa fa-shopping-bag text-primary me-2"></i>Thêm vào giỏ
                                                    </a>
                                                }
                                                else
                                                {
                                                    <span class="text-muted"><i class="fa fa-ban me-2"></i>Chỉ dành cho khách</span>
                                                }
                                            }
                                            else
                                            {
                                                <a class="text-body" href="@Url.Action("DangNhap", "Home")">
                                                    <i class="fa fa-sign-in-alt text-primary me-2"></i>Đăng nhập để mua
                                                </a>
                                            }
                                        }
                                        else
                                        {
                                            @* TRƯỜNG HỢP HẾT HÀNG *@
                                            <span class="text-danger fw-bold"><i class="fa fa-times-circle me-2"></i>Tạm hết hàng</span>
                                        }
                                    </small>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>