
@{
    ViewBag.Title = "Trang chủ";
    ViewBag.BreadcrumbTitle = "Trang chủ";
}

<!-- Carousel Start -->
<div class="container-fluid p-0 mb-5 wow fadeIn" data-wow-delay="0.1s">
    <div id="header-carousel" class="carousel slide" data-bs-ride="carousel">
        <div class="carousel-inner">
            <div class="carousel-item active">
                <img class="w-100" src="~/img/banh-cupcake2.jpg" alt="Image">
                <div class="carousel-caption">
                    <div class="container">
                        <div class="row justify-content-start">
                            <div class="col-lg-7">
                                <h1 class="display-2 mb-3 animated slideInDown">Bánh Ngọt Tươi Mỗi Ngày</h1>
                                <a href="@Url.Action("SanPham","Home")" class="btn btn-primary rounded-pill py-sm-3 px-sm-5">Xem Sản Phẩm</a>
                                <a href="@Url.Action("ChiTiet","Home", new { id = "SP003" })" class="btn btn-secondary rounded-pill py-sm-3 px-sm-5 ms-3">Thử Món Thương Hiệu</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="carousel-item">
                <img class="w-100" src="~/img/banh-croissaint2.jpg" alt="Image">
                <div class="carousel-caption">
                    <div class="container">
                        <div class="row justify-content-start">
                            <div class="col-lg-7">
                                <h1 class="display-2 mb-3 animated slideInDown">Ngọt Ngào Cho Mọi Khoảnh Khắc</h1>
                                <a href="@Url.Action("SanPham","Home", new { id = "DMC003" })" class="btn btn-primary rounded-pill py-sm-3 px-sm-5">Bánh Sinh Nhật</a>
                                <a href="@Url.Action("SanPham","Home", new { id = "DMC008" })" class="btn btn-secondary rounded-pill py-sm-3 px-sm-5 ms-3">Bánh Sự Kiện</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#header-carousel"
                data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#header-carousel"
                data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
        </button>
    </div>
</div>
<!-- Carousel End -->
<!-- About Start -->
<div class="container-xxl py-5">
    <div class="container">
        <div class="row g-5 align-items-center">
            <div class="col-lg-6 wow fadeIn" data-wow-delay="0.1s">
                <div class="about-img position-relative overflow-hidden p-5 pe-0">
                    <img class="img-fluid w-100" src="~/img/banh-ngot-socola.jpg">
                </div>
            </div>
            <div class="col-lg-6 wow fadeIn" data-wow-delay="0.5s">
                <h1 class="display-5 mb-4">Bánh Ngọt Thủ Công – Tươi Ngon Chuẩn Vị</h1>
                <p class="mb-4">
                    Từng chiếc bánh được làm mới mỗi ngày với nguyên liệu chọn lọc.
                    Hương vị nhẹ nhàng, ngọt thanh phù hợp cho mọi độ tuổi.
                    CAKEY luôn đặt chất lượng lên hàng đầu để mang đến trải nghiệm tuyệt vời nhất.
                </p>
                <p><i class="fa fa-check text-primary me-3"></i>Nguyên liệu sạch – Không chất bảo quản</p>
                <p><i class="fa fa-check text-primary me-3"></i>Làm bánh theo yêu cầu</p>
                <p><i class="fa fa-check text-primary me-3"></i>Giao hàng toàn TP.HCM</p>
                <a class="btn btn-primary rounded-pill py-3 px-5 mt-3" href="">Xem thêm</a>
            </div>
        </div>
    </div>
</div>
<!-- About End -->
<!-- Feature Start -->
<div class="container-fluid bg-light bg-icon my-5 py-6">
    <div class="container">
        <div class="section-header text-center mx-auto mb-5 wow fadeInUp" data-wow-delay="0.1s" style="max-width: 500px;">
            <h1 class="display-5 mb-3">Vì Sao Chọn Chúng Tôi</h1>
            <p>Mỗi chiếc bánh đều được làm từ nguyên liệu tươi mới mỗi ngày, đảm bảo hương vị thơm ngon và chất lượng tốt nhất dành cho bạn.</p>
        </div>
        <div class="row g-4">
            <div class="col-lg-4 col-md-6 wow fadeInUp" data-wow-delay="0.1s">
                <div class="bg-white text-center h-100 p-4 p-xl-5">
                    <img class="img-fluid mb-4" src="img/icon-1.png" alt="">
                    <h4 class="mb-3">Bánh Làm Trong Ngày</h4>
                    <p class="mb-4">Nhận làm bánh sinh nhật, bánh tiệc, bánh cưới theo mẫu khách hàng mong muốn.</p>
                    <a class="btn btn-outline-primary border-2 py-2 px-4 rounded-pill" href="">Read More</a>
                </div>
            </div>
            <div class="col-lg-4 col-md-6 wow fadeInUp" data-wow-delay="0.3s">
                <div class="bg-white text-center h-100 p-4 p-xl-5">
                    <img class="img-fluid mb-4" src="img/icon-2.png" alt="">
                    <h4 class="mb-3">Đặt Bánh Theo Yêu Cầu</h4>
                    <p class="mb-4">Nhận làm bánh sinh nhật, bánh tiệc, bánh cưới theo mẫu khách hàng mong muốn.</p>
                    <a class="btn btn-outline-primary border-2 py-2 px-4 rounded-pill" href="">Read More</a>
                </div>
            </div>
            <div class="col-lg-4 col-md-6 wow fadeInUp" data-wow-delay="0.5s">
                <div class="bg-white text-center h-100 p-4 p-xl-5">
                    <img class="img-fluid mb-4" src="img/icon-3.png" alt="">
                    <h4 class="mb-3">Nguyên Liệu Chọn Lọc</h4>
                    <p class="mb-4">Sử dụng bơ, sữa và bột mì cao cấp để tạo ra những chiếc bánh chất lượng nhất.</p>
                    <a class="btn btn-outline-primary border-2 py-2 px-4 rounded-pill" href="">Read More</a>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Feature End -->