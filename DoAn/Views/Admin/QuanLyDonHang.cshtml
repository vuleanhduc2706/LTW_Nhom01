@model IEnumerable<DoAn.Models.DonHang>

@{
    ViewBag.Title = "Quản lý toàn bộ đơn hàng";
    Layout = "~/Views/Shared/_Layout.cshtml"; // Hoặc layout bạn đang dùng
}

<h2>Danh sách đơn hàng toàn hệ thống</h2>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Mã Đơn</th>
            <th>Cửa Hàng</th>
            <th>Khách Hàng</th>
            <th>Ngày Đặt</th>
            <th>Tổng Tiền</th>
            <th>Trạng Thái</th>
            <th>Hành Động</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.MaDon</td>
                <td>@item.GhiChu</td>
                <td>@item.KhachHang.HoTen</td>
                <td>@item.NgayDat.ToString("dd/MM/yyyy")</td>
                <td>@item.TongTien.ToString("#,##0") đ</td>
                <td>
                    @if (item.TrangThai.Contains("Hủy") || item.TrangThai.Contains("xóa"))
                    {
                        <span class="text-danger font-weight-bold">@item.TrangThai</span>
                    }
                    else
                    {
                        <span class="text-success">@item.TrangThai</span>
                    }
                </td>
                <td>
                    @if (!item.TrangThai.Contains("Admin"))
                    {
                        using (Html.BeginForm("XoaDonHangByAdmin", "Admin", FormMethod.Post, new { onsubmit = "return confirm('Bạn chắc chắn muốn xóa đơn này? Hành động này sẽ hoàn kho và thông báo cho người bán.');" }))
                        {
                            <input type="hidden" name="maDon" value="@item.MaDon" />
                            <button type="submit" class="btn btn-danger btn-sm">Xóa (Admin)</button>
                        }
                    }
                </td>
            </tr>
        }
    </tbody>
</table>